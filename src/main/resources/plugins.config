# A single .jar file can contain multiple plugins, specified in separate lines.
#
# The format is: <menu>, "<menu label>", <class name>

Plugins>Neural Image Processor, "Classify Cells (OPC/B3Tub/RFP)...", com.neuralimgs.fiji.NeuralClassifyPlugin
Plugins>Neural Image Processor, "Show Cell (all channels)...", com.neuralimgs.fiji.NeuralClassifyPlugin("showCell")
# Not required -- the first classify run installs the models itself. Here so the
# ~90 MB download can be done ahead of a session, and so "are the models there?"
# has an answer that does not involve starting an hours-long run.
Plugins>Neural Image Processor, "Install / Verify Models...", com.neuralimgs.fiji.NeuralClassifyPlugin("installModels")
